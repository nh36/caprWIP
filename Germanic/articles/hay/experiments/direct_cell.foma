# Research-only cascades: the direct cell of 'hay' under the competing
# apocope chronologies. Cycle-9 revision.
#
# NOT a production cascade. This file exists solely to verify the cycle-9
# derivations in ../DERIVATIONS.md. It must never be composed into
# Germanic/fsts/germanic.txt or any adopted model.
#
# The cycle-8 version of this file encoded the (erroneous) assumption that
# no loss of *w before *i existed. Ringe & Taylor 2014: 257-61 (6.7.1)
# establish that non-word-initial *w was regularly lost before fully
# unstressed *i, after i-umlaut and before general syncope; Campbell 1959:
# SS237.1.b, 406, pp. 327-8 and Hogg 1992: S5.133 agree. The frozen
# production definition OEWLossBeforeI already encodes this change with
# those citations. The present cascades therefore INCLUDE the w-loss and
# the subsequent contraction (R&T 6.9.3 p. 318), and model the documented
# exceptions by their documented mechanisms:
#   - eowu 'ewe': transferred to the o-stems BEFORE w-loss (R&T p. 259);
#     modelled here as a post-umlaut input ewu, to which w-loss correctly
#     does not apply.
#   - cleweþa 'itch': R&T pp. 260-1 explicitly flag it as an isolated
#     exception (lexical analogy with clawan, or suffix-form competition);
#     the regular cascade accordingly predicts **cleþa, and the PASS below
#     records that the attested form is the exception, not the rule.
#
# Inputs are post-i-umlaut pre-OE shapes (asterisks omitted), isolating
# the two contested steps (w-loss, contraction) from uncontested earlier
# developments:
#   hewi      'hay' direct cell under early apocope (< *hawi < *hawja;
#             = attested OHG hewi; R&T pp. 53, 173; Campbell S579(4))
#   gliwi     'glee' direct cell (R&T pp. 259, 318 -> gli)
#   pylwi     'pillow' (Lat. pulvinus; R&T p. 260 -> pyle)
#   ewidi     'flock' (*awidi; R&T p. 259 -> Angl. ede with long e)
#   meti      'food'      } no-w controls for the final-vowel treatment
#   meni      'necklace'  } (R&T pp. 236-7; Stiles 2013: 15-16)
#   ewu       'ewe' after o-stem transfer (R&T p. 259)
#   klewiþa   'itch' (regular prediction **cleþa; attested cleweþa is
#             R&T's flagged lexical exception)

define V [a|e|i|o|u|y|ā|ē|ī|ō|ū|ȳ|æ|ǣ];
define Cns [b|c|d|f|g|h|k|l|m|n|p|r|s|t|w|þ|ð];

# Loss of non-word-initial *w before fully unstressed *i
# (R&T 6.7.1 pp. 258-60; Campbell S406; cf. frozen OEWLossBeforeI, which
# uses the same V Cns* _ i environment to cover the gierwan-class verbs)
define WLoss w -> 0 || V Cns* _ [i|ī];

# Contraction of the resulting hiatus (R&T 6.9.3 p. 318: *glii, *eidi,
# *streide "can only have become" gli, ede, strede by contraction, since
# only contraction accounts for their long vowels). Possibly delayed by
# generations: early Merc. streide (EpGl 899) and the disyllabic scansion
# of stred at Beo 2436 show the uncontracted stage (Campbell S237.1.b;
# Hogg S5.133).
define Contract [e i -> ē , i i -> ī];

# Weakening of retained final *-i to -e after a consonant (mete class,
# R&T pp. 236-7). Apocope after heavy syllables is not exercised by these
# curated inputs and is not modelled.
define FinalIWeaken i -> e || Cns _ .#.;

# Orthography: k -> c
define Orth k -> c;

regex WLoss .o. Contract .o. FinalIWeaken .o. Orth;
save stack wloss_contract.bin
clear stack

# ---------------------------------------------------------------------------
# The pre-contraction hiatus stage (Campbell S237.1.b "*kaui- > *kei- >
# *ke-"; spelling <ei> in Cp. streide). Relevant to the interpretation of
# the earliest <hei-> spellings: hiatus could persist for some generations
# (R&T p. 318).

regex WLoss .o. Orth;
save stack hiatus_stage.bin
clear stack

# ---------------------------------------------------------------------------
# Analogical restoration of final -ġ from the protected cells. This is a
# morphological operation, kept separate from the phonological cascades.
# Precedent: gli -> glig "a re-formation" (Campbell SS411, 579(4): the
# attested nom.-acc. sg. forms stand "under influence of the other
# cases"); R&T p. 259 "gli, glig-".

define GRestore [..] -> ġ || [ē|ī] _ .#.;

regex GRestore;
save stack g_restore.bin
clear stack

# ---------------------------------------------------------------------------
# Late-apocope (B2-type) reference cascade for the diphthongal nucleus:
# pre-OE *hauj (direct cell under late apocope, after *-awj- > *-auj-
# resolution) and *auju 'island' (R&T pp. 173, 246). Unchanged from
# cycle 8.

define AuBright a u -> ē a;
define EaUmlaut ē a -> ī e || _ j;
define FinalULoss u -> 0 || j _ .#.;
define GOrth j -> ġ || _ .#.;

regex AuBright .o. EaUmlaut .o. FinalULoss .o. GOrth;
save stack late_b2.bin
clear stack
quit
