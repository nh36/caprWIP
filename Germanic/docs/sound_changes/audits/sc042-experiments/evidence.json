  "source_review": {
    "scope": "SC042 source criticism; originals consulted locally, no copyrighted holdings or page reproductions in the public evidence archive",
    "readings": [
      {
        "key": "RingeTaylor2014",
        "holding": "docs/references/ringe_taylor_linguistic_history_vol2.pdf",
        "printed_pages": "58-60,157-158,189-190,299-300",
        "verified_images": [
          59,
          299
        ],
        "pagination": "Printed 59 is physical sheet 74; printed 299 is physical sheet 314.",
        "finding": "Explicit WGmc bimoric long o to long a finally and before final r, contrasted with trimoric o and other unstressed environments; comparative examples include gift genitive/accusative, water, four, tongue, heart, weak-past endings, and negative name/plural quantities. Early Runic is reported as retaining o. Long a and long ae in the later endings are explicitly reconstructed, not a length invented by CAPR. Pages157-158 are not direct evidence for this law;189-190 concern restoration.",
        "limits": "Comparative and runic evidence is the secondary authors' argument; Stiles1988 and the primary inscriptions were not freshly independently examined.",
        "holding_sha256": "278f94f6076a31278ecca75d8d0429f0822728e5efe0ec3011186a694cf8d6f2"
      },
      {
        "key": "Campbell1959",
        "holding": "docs/references/campbell_old_english_grammar.pdf",
        "printed_pages": "52,60-61",
        "sections": "131,157-158",
        "pagination": "Printed52 is physical70; printed60-61 are physical78-79. Section158 is on printed61, not60.",
        "finding": "Stressed a-fronting and later back-vowel-conditioned restoration, including sC clusters. Context for the downstream mechanism, not independent documentation of the WGmc unrounding law.",
        "holding_sha256": "fcb26efd5537a04ae3b202154e79a06b1b0c719e2f0ebabd261442e7449d3611"
      },
      {
        "key": "HoggPhonology1992",
        "holding": "docs/references/hogg_chel_1992_volume1.pdf",
        "printed_pages": "102,105",
        "verified_images": [
          102,
          105
        ],
        "pagination": "Printed102/105 are physical126/129.",
        "identity": "Phonology and Morphology, Cambridge History of the English Language I, not the similarly dated monograph.",
        "finding": "The original cited chapter discusses stressed low-vowel fronting/breaking on102 and restoration on105. It contextualizes the English developments but is not direct independent support for the unrounding law.",
        "holding_sha256": "0874395a7ae66ed27641f8e937d0e2fd300b4af11aae60757f732c4cbae9c486"
      },
      {
        "key": "HoggGrammar2011",
        "holding": "docs/references/hogg_fulk_2011_grammar_old_english_vol1_phonology.pdf",
        "printed_pages": "64,227-228",
        "sections": "3.32,6.26-28 and6.27 note2",
        "verified_images": [
          64,
          227,
          228
        ],
        "pagination": "Printed64 is physical77;227-228 are physical240-241. The title/copyright establish the2011 paperback reissue of the1992 monograph; no transferred1992 page claims.",
        "finding": "Separates nasal-associated low-vowel outcomes, preserved long quantities and subsequent shortening. Lists o-stem genitives among the long-vowel histories under discussion and explicitly warns that classification of all such cases as trimoric is difficult and controversial. This is not identical to Ringe-Taylor's bimoric-genitive analysis.",
        "limits": "Lane1963 and Stiles1988 are cited by Hogg but not independently consulted. The2011 monograph and1992 chapter were verified as distinct bibliographic identities before the verdict.",
        "holding_sha256": "f8e6d35e5ff1c6ca3a4c26f425a8fb38462d7a96a5255d4f16f4f9337b28a773"
      }
